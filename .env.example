# .env.example
GITHUB_API_KEY=your_github_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LM_STUDIO_ENDPOINT=http://localhost:1234

# Web UI 登录凭据（默认 admin / admin123；生产环境请务必修改）
STRIDE_GPT_USERNAME=admin
STRIDE_GPT_PASSWORD=admin123

# Optional. Host for the Streamlit diagram editor (embedded draw.io). Defaults
# to the public embed.diagrams.net. Point it at a self-hosted draw.io (scheme +
# host) for air-gapped/enterprise deployments; embed query params are appended.
# STRIDE_GPT_DRAWIO_URL=https://drawio.internal.example.com
# 数据目录（默认 ~/.stride-gpt；容器/服务化部署建议显式指定）
# STRIDE_GPT_DATA_DIR=/var/lib/wy

# 会话有效期（天，1-30；也可在「系统配置 → 安全策略」中修改并持久化）
# STRIDE_GPT_SESSION_DAYS=7

# HTTPS 部署时置 1：会话 Cookie 追加 Secure 标记
# STRIDE_GPT_SECURE_COOKIE=1

# 日志级别（DEBUG/INFO/WARNING/ERROR）
# STRIDE_GPT_LOG_LEVEL=INFO

# 调试模式：置 1 时错误卡片对所有人展开技术细节（仅本地排障使用）
# STRIDE_GPT_DEBUG=1

# API 服务地址（系统状态页探测用）
# STRIDE_GPT_API_URL=http://127.0.0.1:8000
